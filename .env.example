APP_NAME=GoBackend
APP_ENV=development
APP_PORT=1067

# Jenis database: sqlserver (default) | postgres | sqlite
# - sqlserver/postgres: isi DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD
# - sqlite: cukup DB_DATABASE sebagai path file (mis. ./data/go-core.db),
#   host/port/username/password diabaikan, file dibuat otomatis
DB_CONNECTION=sqlserver
DB_HOST=localhost
DB_PORT=1433
DB_DATABASE=Go
DB_USERNAME=
DB_PASSWORD=
# Optional pool tuning (defaults 25 / 10)
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=10

# min 32 chars — generate: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
