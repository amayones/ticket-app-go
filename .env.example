# Nama aplikasi = judul tab browser, nama di sidebar, dan kartu login.
# Ganti di sini, lalu build ulang frontend (task build-frontend).
APP_NAME=Go Core
# Logo aplikasi = favicon tab + logo di sidebar/kartu login.
# File dari frontend/public/ (disalin apa adanya ke dist/).
# Ganti file favicon.svg, atau taruh file lain lalu arahkan ke sini,
# mis. APP_LOGO=/logo-toko.png
APP_LOGO=/favicon.svg
APP_ENV=development
APP_PORT=1067

# Jenis database: sqlserver (default) | postgres | sqlite
# - sqlserver/postgres: isi DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD
# - sqlite: cukup DB_DATABASE sebagai path file (mis. ./data/go-core.db),
#   host/port/username/password diabaikan, file dibuat otomatis
DB_CONNECTION=sqlserver
DB_HOST=localhost
DB_PORT=1433
# Nama database BEBAS (mis. GoCore) — wajib sama dengan database yang Anda
# buat di SQL Server dan perintah sqlcmd -d yang Anda pakai.
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Optional pool tuning (defaults 25 / 10)
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=10

# Umur sesi: access dalam menit (default 15), refresh dalam hari (default 7).
# Contoh cek modal sesi-habis: ACCESS_TOKEN_MINUTES=1
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# min 32 chars — generate: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
