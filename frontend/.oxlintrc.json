{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/app/**/index.jsx"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      // Template seragam: semua index.jsx memakai header import yang sama
      // (terpakai/tidak tidak masalah), jadi matikan warning unused khusus app.
      "files": ["src/app/**/*.{js,jsx}"],
      "rules": {
        "no-unused-vars": "off"
      }
    }
  ]
}
