# File ini khusus variabel Vite untuk frontend.
# Nama aplikasi (APP_NAME) dan port backend (APP_PORT) dibaca dari .env di
# root repository, jadi cukup diatur di sana — bukan di file ini.
#
# Kosongkan untuk memakai proxy Vite (default dev: http://localhost:5173).
# Isi hanya bila frontend di-host terpisah dari backend.
VITE_API_URL=http://localhost:1067
